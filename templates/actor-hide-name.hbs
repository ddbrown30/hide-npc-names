<div class="standard-form" autocomplete="off">
    <h2><i class="fas fa-mask"></i> {{localize "HNN.ActorForm.Title"}}</h4>
    <div class="form-group">
        <label>{{localize "HNN.ActorForm.TokenDisposition"}}{{dispositionString}}</label>
        <p class="hint">{{localize "HNN.ActorForm.TokenDispositionHint"}}</p>
    </div>
    <div class="form-group">
        <label>{{localize "HNN.ActorForm.DefaultBehaviour"}}{{hideSettingString}}</label>
        <p class="hint">{{localize "HNN.ActorForm.DefaultBehaviourHint"}}</p>
    </div>
    <div class="form-group">
        <label>{{localize "HNN.ActorForm.HiddenEnabled"}}</label>
        <input type="checkbox" name="hide-name" {{checked nameHidden}}>
        <p class="hint">{{localize "HNN.ActorForm.HiddenEnabledHint"}}</p>
    </div>
    <div class="form-group">
        <label>{{localize "HNN.ActorForm.ReplacementName"}}</label>
        <input type="text" name="replacement-name" value="{{replacementName}}">
        <p class="hint">{{localize "HNN.ActorForm.ReplacementHint"}}</p>
    </div>
    <footer class="form-footer">
        <button type="button" name="save" data-action="save">{{localize "HNN.ActorForm.Save"}}</button>
        <button type="button" name="clear" data-action="clear">{{localize "HNN.ActorForm.ClearOverrides"}}</button>
        <button type="button" name="cancel" data-action="cancel">{{localize "HNN.ActorForm.Cancel"}}</button>
    </footer>
</form>